{
  "openapi": "3.0.3",
  "info": {
    "title": "PDF Merge API",
    "version": "1.0.0"
  },
  "paths": {
    "/merge-pdf": {
      "post": {
        "summary": "Mescla PDFs em um único arquivo",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "PDF final",
            "content": {
              "application/pdf": {}
            }
          },
          "400": {
            "description": "Erro de validação"
          },
          "500": {
            "description": "Erro interno"
          }
        }
      }
    }
  }
}
